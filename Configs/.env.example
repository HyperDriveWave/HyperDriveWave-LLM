# HyperDriveWave 配置模板 —— 由 Scripts/gen_env_example.sh 从 Configs/.env 生成。
#
# 新机器：cp Configs/.env.example Configs/.env 后按实际环境修改。
# 或直接跑 bash Scripts/deploy.sh，它会自动生成并引导你填关键项。
#
# **不要手工编辑这个文件**——改了会在下次生成时被覆盖。
# 要加新配置项，先加到 Configs/.env，再跑一次生成脚本。

# HyperDriveWave deployment defaults. Copy to Configs/.env and change secrets.

# [deploy] 已注释以保持可移植（代码默认值自定位）：HDW_PROJECT_ROOT=<项目根>
# [deploy] 已注释以保持可移植（代码默认值自定位）：HDW_RUNTIME_ROOT=<项目根>/HDW_Runtime
HDW_COMPOSE_PROFILES="base knowledge web"

HDW_WEBUI_BIND=172.16.2.32
HDW_WEBUI_PORT=3000
HDW_WEBUI_TLS_PORT=8443
HDW_QA_API_PORT=8080
HDW_LLM_PORT=8000
HDW_RAG_PORT=8001
HDW_MINERU_PORT=8002
HDW_KEYCLOAK_PORT=8081
HDW_LANGFUSE_PORT=3100
HDW_NEO4J_HTTP_PORT=7475
HDW_NEO4J_BOLT_PORT=7688
# Current compose consumes the ports above; Keycloak and Langfuse ports are reserved for future profiles.

HDW_LLM_GPU=0
HDW_RAG_GPU=1
HDW_MINERU_GPU=0
HDW_LLM_MAX_RUNNING_REQUESTS=1
HDW_LLM_MEMORY_RATIO=0.98
HDW_LLM_MAX_TOKENS=8192
# 抑制模型复读检索原文（复读会撞 max_tokens 上限并触发 chat 解析失败）。调大更不易复读、更易跑题。
HDW_LLM_PRESENCE_PENALTY=0.3
HDW_LLM_MAX_PREFILL_LENGTH=512
HDW_LOCAL_MAX_SEQ_LEN=262144
HDW_LOCAL_MAX_OUTPUT_TOKENS=8192
HDW_LOCAL_REASONING_PARSER=qwen3
HDW_LLM_MODE=offline
HDW_LOCAL_LLM_BASE_URL=http://host.docker.internal:1919/v1
HDW_LOCAL_LLM_MODEL=Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf
HDW_ONLINE_LLM_BASE_URL=https://api.deepseek.com
HDW_ONLINE_LLM_MODEL=deepseek-v4-flash
HDW_ONLINE_LLM_API_KEY=your-key
HDW_LLM_TIMEOUT=180
HDW_LLAMA_TIMEOUT=0
# 本地推理后端。CUDA 版实测解码 +20%、预填充 +110%（对比 Vulkan）。
# 切回 Vulkan：HDW_LLAMA_DEVICE=Vulkan0 + HDW_LLAMA_BINARY=<项目>/HDW_Inference/llama/build/bin/llama-server
HDW_LLAMA_DEVICE=CUDA0
# [deploy] 已注释以保持可移植（代码默认值自定位）：HDW_LLAMA_BINARY=<项目根>/HDW_Inference/llama/llama.cpp-upstream/build-cuda/bin/llama-server
HDW_ONLINE_GRAPH_TOP_K=40
HDW_LOCAL_GRAPH_TOP_K=10
HDW_CONTEXT_WINDOW_TOKENS=1000000
HDW_LOCAL_CONTEXT_WINDOW_TOKENS=262144
HDW_CONTEXT_COMPRESSION_THRESHOLD=0.75
HDW_CONTEXT_COMPRESSION_TARGET=0.55
HDW_CONTEXT_COMPRESSION_MAX_TOKENS=2000
# 历史相关性选留：每次提问前判断哪些历史轮次和当前问题相关，无关的不进 prompt。
# 上面的压缩是兜底（选留后仍超长才按 75% 阈值出手），两者互不影响。
# 设为 0 可一键退回「全量历史」的老行为。
HDW_HISTORY_SELECT=1
# 历史少于这么多轮就不判断——刚开始对话时选留没意义，白花一次调用。
HDW_HISTORY_SELECT_MIN_TURNS=3
# 最多把最近多少轮交给选择器；更早的一律丢弃（近因策略，也让选择器输入有上界）。
HDW_HISTORY_SELECT_MAX_TURNS=20

POSTGRES_DB=hdw
POSTGRES_USER=hdw
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hdw:change_me@hdw-postgres:5432/hdw
REDIS_PASSWORD=change_me
NEO4J_AUTH=neo4j/change_me
NEO4J_URI=bolt://hdw-neo4j:7687

HDW_LLM_BASE_URL=http://host.docker.internal:1919/v1
HDW_RAG_BASE_URL=http://hdw-rag:8001
# Remote GPU RAG nodes; ingest synchronizes both nodes after local rebuild.
HDW_RAG_REMOTE_URLS=http://172.16.2.186:8001,http://172.16.2.186:8003
HDW_RAG_ADMIN_TOKEN=your-token
# 0 = 不设超时。远端节点不回包时，同步会永远等下去，作业和文档永久卡在
# 「同步中」（实测 172.16.2.186:8003 即是如此）。600 是单个 socket 操作的
# 超时而非总时长，正常上传不受影响。
HDW_REMOTE_RAG_SYNC_TIMEOUT=600
HDW_RAG_TIMEOUT=60
HDW_RAG_CONNECT_TIMEOUT=3
HDW_RAG_HEALTH_TIMEOUT=5
HDW_REMOTE_RAG_SSH_TARGET=linux-02@172.16.2.186
# [deploy] 已注释以保持可移植：这是**远端机**上的项目根，本机代码无法自定位，
# 必须按实际部署填写。留空时 Scripts/sync_remote_rag.sh 会明确报错而不是猜一个路径。
# HDW_REMOTE_RAG_ROOT=/home/<远端用户名>/HyperDriveWave-RAG
HDW_MINERU_BASE_URL=http://hdw-mineru:8002
HDW_QA_API_BASE_URL=http://hdw-qa-api:8080
HDW_MCP_BASE_URL=http://hdw-mcp:8766/mcp
# MCP 工具的读取超时。**必须大于工具内部最慢的那次抓取**——日志工具要等 LIEMS 门户，
# 它自己的 read timeout 就是 30 秒。原来写死 rag_connect_timeout+15=18 秒，比 LIEMS 先到，
# 于是一次取数失败只剩下一个空消息的 ReadTimeout，工具已备好的失败原因全被切断。
HDW_MCP_TIMEOUT=60
# [deploy] 已注释以保持可移植（代码默认值自定位）：HDW_MODEL_CONFIG_PATH=/data/model-config/config.json
# Reserved for future profiles: Dify, n8n, Keycloak, Langfuse, and GPU-backed RAG/MinerU.
# [deploy] 已注释以保持可移植（代码默认值自定位）：HDW_ZVEC_COLLECTION_PATH=<项目根>/HDW_Runtime/zvec/industrial_chunks
HDW_RAG_DEVICE=cpu
HDW_EMBED_MAX_LENGTH=1024
HDW_RERANK_MAX_LENGTH=512
HDW_RERANK_CANDIDATES=50
HDW_MAINTENANCE_TIMEOUT=0

KEYCLOAK_URL=http://hdw-keycloak:8080
KEYCLOAK_REALM=hyperdrivewave
KEYCLOAK_CLIENT_ID=hdw-web
KEYCLOAK_CLIENT_SECRET=change_me

LANGFUSE_HOST=http://hdw-langfuse-web:3000
LANGFUSE_PUBLIC_KEY=change_me
LANGFUSE_SECRET_KEY=change_me

WEBUI_SECRET_KEY=change_me
HDW_INTERNAL_API_KEY=local-dev-key
HDW_ENABLE_AUTH=false
HDW_AUTH_SECRET=your-key

# 公网 FRP 隧道（控制中心「外网访问」页展示用；远端端口由 frps 的 allowPorts 固定为 8080/8443）
HDW_FRP_PUBLIC_HOST=47.102.96.145
HDW_FRP_SYSTEMD_UNIT=hyperdrivewave-frpc.service

# SIS 实时测点（来源：SmartGasTurbine deploy/config.local.json 的 sis_data.sis）
# 供 HDW_DataFoundation/MCP 的 point_query_* / thermal_query_* 工具取实时值
HDW_SIS_BASE_URL=https://www.xtgjhdqd.cn
HDW_SIS_LOGIN_URL=https://www.xtgjhdqd.cn/login.html
HDW_SIS_USERNAME=your-username
HDW_SIS_PASSWORD=change_me
HDW_SIS_LANGUAGE=zh-Hans
# 采集时间展示时区偏移（SIS 存的是 UTC）。输出不带时区后缀；改后需 --force-recreate hdw-qa-api
HDW_LIVE_TIME_OFFSET_HOURS=8

# 镜像构建期的 pip 源。**docker build 里的 pip 不读宿主机的 /etc/pip.conf**，
# 只能由 compose 通过 build-arg 注入，所以这一项必须在这里配。
# 回官方源填 https://pypi.org/simple ；改后需要 --force-recreate 重建镜像才生效。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
