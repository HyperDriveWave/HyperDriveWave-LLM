# HyperDriveWave GPU 资源协调器（systemd **用户**单元）
#
# ⚠ 这是**模板**，不是能直接用的单元文件：里面的 @HDW_ROOT@ 是占位符，
#   安装时由 Scripts/lib/common.sh 的 install_hdw_units() 替换成本机实际路径，
#   写到 ~/.config/systemd/user/ 下才生效。
#
# 为什么不写死路径、也不用 systemctl --user link 直接链这份：
#   link 是软链，文件内容原样生效。而这份文件里一旦写死某台机器的路径，
#   换机器或换安装目录后单元就指向不存在的文件。更隐蔽的是下面
#   `EnvironmentFile=-` 的那个 `-`：文件缺失时 systemd **不报错**，
#   静默用默认值启动——服务看着起来了，配置却是另一套。
#   2026-10-01 在一台麒麟 V10 服务器上实际踩到：项目在 /opt/hdw/app，
#   单元却指向 %h/桌面/HyperDriveWave，ExecStart 报 127。

[Unit]
Description=HyperDriveWave GPU resource coordinator
After=default.target

[Service]
Type=simple
WorkingDirectory=@HDW_ROOT@
EnvironmentFile=-@HDW_ROOT@/Configs/.env
Environment=HDW_PROJECT_ROOT=@HDW_ROOT@
Environment=HDW_MODEL_CONFIG_PATH=@HDW_ROOT@/HDW_Runtime/model-config/config.json
Environment=HDW_MAINTENANCE_SOCKET=@HDW_ROOT@/HDW_Runtime/maintenance/maintenance.sock
ExecStart=/usr/bin/python3 @HDW_ROOT@/Scripts/resource_coordinator.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
